---
permalink: /profile.json
sitemap: false
layout: null
---
{%- assign services = site.services | sort: 'weight' -%}
{
  "$schema": "https://schema.org",
  "@type": "Organization",
  "name": {{ site.title | jsonify }},
  "legalName": "Mobconverge, LLC",
  "url": {{ '/' | absolute_url | jsonify }},
  "description": {{ site.description | jsonify }},
  "logo": {{ site.logo.desktop | absolute_url | jsonify }},
  "generated": {{ site.time | date: "%Y-%m-%d" | jsonify }},
  "principal": {
    "name": "Mark Schisler",
    "jobTitle": "Principal",
    "url": {{ '/about/' | absolute_url | jsonify }}
  },
  "contact": {
    "email": {{ site.data.contact.email | jsonify }},
    "address": {
      "name": {{ site.data.contact.address_name | jsonify }},
      "streetAddress": {{ site.data.contact.address_line1 | jsonify }},
      "addressLocality": {{ site.data.contact.address_city | jsonify }},
      "addressRegion": {{ site.data.contact.address_state | jsonify }},
      "postalCode": {{ site.data.contact.address_zip | jsonify }},
      "addressCountry": "US"
    },
    "map": {{ site.data.contact.address_link | jsonify }}
  },
  "social": [{% for s in site.data.social %}
    { "name": {{ s.name | jsonify }}, "url": {{ s.link | jsonify }} }{% unless forloop.last %},{% endunless %}{% endfor %}
  ],
  "services": [{% for service in services %}
    {
      "name": {{ service.title | jsonify }},
      "url": {{ service.url | absolute_url | jsonify }},
      "summary": {{ service.summary | jsonify }},
      "description": {{ service.description | jsonify }}
    }{% unless forloop.last %},{% endunless %}{% endfor %}
  ],
  "faq": [{% for item in site.data.faq %}
    { "question": {{ item.question | jsonify }}, "answer": {{ item.answer | jsonify }} }{% unless forloop.last %},{% endunless %}{% endfor %}
  ],
  "resources": {
    "llms": {{ '/llms.txt' | absolute_url | jsonify }},
    "llmsFull": {{ '/llms-full.txt' | absolute_url | jsonify }},
    "sitemap": {{ '/sitemap.xml' | absolute_url | jsonify }},
    "securityTxt": {{ '/.well-known/security.txt' | absolute_url | jsonify }}
  }
}
